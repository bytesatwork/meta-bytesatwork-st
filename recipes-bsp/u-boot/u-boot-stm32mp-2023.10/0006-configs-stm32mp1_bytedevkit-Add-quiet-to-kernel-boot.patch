From 043dc1dcf3ccae2fd855ae872e227e47c6f01671 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Tue, 30 Sep 2025 10:57:37 +0200
Subject: [PATCH] configs: stm32mp1_bytedevkit: Add quiet to kernel bootargs

Reduces output during boot to speed up total boot time.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 include/configs/stm32mp1_bytedevkit.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/configs/stm32mp1_bytedevkit.h b/include/configs/stm32mp1_bytedevkit.h
index 55385c7cfe..ec6608099c 100644
--- a/include/configs/stm32mp1_bytedevkit.h
+++ b/include/configs/stm32mp1_bytedevkit.h
@@ -57,7 +57,7 @@
 	"console=ttySTM0,115200\0" \
 	"default_args=rootwait rw vt.global_cursor_default=0 consoleblank=0\0" \
 	"mmc_args=setenv bootargs ${default_args} console=${console} " \
-		"root=${mmc_root} ${bootargs_append}; \0" \
+		"root=${mmc_root} quiet ${bootargs_append}; \0" \
 	"select_dtb=if hwid check; " \
 		"then " \
 			"setenv dtbfile \"" \
