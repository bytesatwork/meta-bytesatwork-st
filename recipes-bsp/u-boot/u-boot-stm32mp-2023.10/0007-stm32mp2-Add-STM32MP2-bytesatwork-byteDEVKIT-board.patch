+		fdt_simplefb_enable_and_mem_rsv(blob);
+
+	ret = fixup_stm32mp2xx_disco_panel(blob);
+	if (ret)
+		log_err("Error during panel fixup ! (%d)\n", ret);
+
+	return 0;
+}
