From 57c7ba5ccfd858f5010c9471a8c03ef48f1cce22 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Tue, 2 Sep 2025 15:06:20 +0200
Subject: [PATCH] bytesatwork: stm32mp2: Introduce bawconfig

Enable bytesatwork tool to store production data in EEPROM.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 board/bytesatwork/bytedevkit_stm32mp2/Kconfig  | 1 +
 board/bytesatwork/bytedevkit_stm32mp2/Makefile | 1 +
 configs/stm32mp257_bytedevkit_defconfig        | 4 ++++
 include/configs/stm32mp2_bytedevkit.h          | 4 ++++
 4 files changed, 10 insertions(+)

diff --git a/board/bytesatwork/bytedevkit_stm32mp2/Kconfig b/board/bytesatwork/bytedevkit_stm32mp2/Kconfig
index 1a93809b6bb..54d578d3be1 100644
--- a/board/bytesatwork/bytedevkit_stm32mp2/Kconfig
+++ b/board/bytesatwork/bytedevkit_stm32mp2/Kconfig
@@ -10,5 +10,6 @@ config SYS_CONFIG_NAME
 	default "stm32mp2_bytedevkit"
 
 source "board/st/common/Kconfig"
+source "board/bytesatwork/baw_config/Kconfig"
 
 endif
diff --git a/board/bytesatwork/bytedevkit_stm32mp2/Makefile b/board/bytesatwork/bytedevkit_stm32mp2/Makefile
index 4c116ae4b96..3b77f6050e0 100644
--- a/board/bytesatwork/bytedevkit_stm32mp2/Makefile
+++ b/board/bytesatwork/bytedevkit_stm32mp2/Makefile
@@ -7,3 +7,4 @@
 # Copyright (C) 2023, STMicroelectronics - All Rights Reserved
 #
 obj-y += stm32mp2-bytedevkit.o
+obj-y += ../baw_config/
diff --git a/configs/stm32mp257_bytedevkit_defconfig b/configs/stm32mp257_bytedevkit_defconfig
index 219aeb9c9ca..c5cf9b6696e 100644
--- a/configs/stm32mp257_bytedevkit_defconfig
+++ b/configs/stm32mp257_bytedevkit_defconfig
@@ -13,6 +13,10 @@ CONFIG_TARGET_STM32MP2_BYTEDEVKIT=y
 CONFIG_CMD_STM32PROG=y
 CONFIG_SYS_LOAD_ADDR=0x84000000
 CONFIG_ENV_ADDR=0x60900000
+CONFIG_BAW_CONFIG_EEPROM_BUS_NAME="i2c@40150000"
+CONFIG_BAW_CONFIG_EEPROM_ADDRESS_BYTES=1
+CONFIG_BAW_CONFIG_EEPROM_MAX_WRITE=16
+CONFIG_BAW_CONFIG_EEPROM_WRITE_DELAY_MS=5
 CONFIG_FWU_NUM_IMAGES_PER_BANK=1
 CONFIG_OF_BOARD_FIXUP=y
 CONFIG_SYS_MEMTEST_START=0x84000000
diff --git a/include/configs/stm32mp2_bytedevkit.h b/include/configs/stm32mp2_bytedevkit.h
index ad989751dc2..83474a110bb 100644
--- a/include/configs/stm32mp2_bytedevkit.h
+++ b/include/configs/stm32mp2_bytedevkit.h
@@ -46,4 +46,8 @@
 		"root=${mmc_root} quiet ${bootargs_append}; \0" \
 	MMC_BOOT_CMD
 
+#define BAW_CONFIG_BUILTIN_PCB		M10_PCB_REV_0_1
+#define BAW_CONFIG_BUILTIN_RAM		M10_RAM_MT53D512M16D1DS_046
+#define BAW_CONFIG_BUILTIN_FLASH	EMMC_128GB
+
 #endif
