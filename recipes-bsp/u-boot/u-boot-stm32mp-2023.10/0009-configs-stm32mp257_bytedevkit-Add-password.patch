From 44996b07076e9b462de8b1c6c42c62b87c4d4b6a Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Tue, 20 Jan 2026 14:09:57 +0100
Subject: [PATCH] configs: stm32mp257_bytedevkit: Add password

Enables autoboot stop password and sets boot delay to 1 second.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 configs/stm32mp257_bytedevkit_defconfig | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/configs/stm32mp257_bytedevkit_defconfig b/configs/stm32mp257_bytedevkit_defconfig
index c5cf9b6696..ac4e1a2dfc 100644
--- a/configs/stm32mp257_bytedevkit_defconfig
+++ b/configs/stm32mp257_bytedevkit_defconfig
@@ -28,6 +28,10 @@ CONFIG_FIT_SIGNATURE=y
 CONFIG_LEGACY_IMAGE_FORMAT=y
 CONFIG_DISTRO_DEFAULTS=y
 CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_BOOTCOMMAND="mmc rescan; run mmc_boot"
 CONFIG_FDT_SIMPLEFB=y
 CONFIG_CMD_BDINFO_EXTRA=y
