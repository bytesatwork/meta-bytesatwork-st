From 04999e32fedfa8f3594d529ed2a6e125d2ead4b9 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Tue, 30 Sep 2025 09:26:32 +0200
Subject: [PATCH] configs: stm32mp157_bytedevkit: Add password

Enables autoboot stop password and sets boot delay to 1 second.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 configs/stm32mp157_bytedevkit_1g_defconfig | 5 +++++
 configs/stm32mp157_bytedevkit_defconfig    | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/configs/stm32mp157_bytedevkit_1g_defconfig b/configs/stm32mp157_bytedevkit_1g_defconfig
index 6c02b1d7a1..6ba513f309 100644
--- a/configs/stm32mp157_bytedevkit_1g_defconfig
+++ b/configs/stm32mp157_bytedevkit_1g_defconfig
@@ -19,6 +19,11 @@ CONFIG_BAW_CONFIG_EEPROM_WRITE_DELAY_MS=5
 CONFIG_ENV_VARS_UBOOT_CONFIG=y
 CONFIG_FIT=y
 CONFIG_SUPPORT_RAW_INITRD=y
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_BOOTCOMMAND="run select_dtb;mmc rescan;run mmc_boot"
 # CONFIG_CONSOLE_MUX is not set
diff --git a/configs/stm32mp157_bytedevkit_defconfig b/configs/stm32mp157_bytedevkit_defconfig
index 6723e6072b..fef41c2c32 100644
--- a/configs/stm32mp157_bytedevkit_defconfig
+++ b/configs/stm32mp157_bytedevkit_defconfig
@@ -18,6 +18,11 @@ CONFIG_BAW_CONFIG_EEPROM_WRITE_DELAY_MS=5
 CONFIG_ENV_VARS_UBOOT_CONFIG=y
 CONFIG_FIT=y
 CONFIG_SUPPORT_RAW_INITRD=y
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_BOOTCOMMAND="run select_dtb;mmc rescan;run mmc_boot"
 # CONFIG_CONSOLE_MUX is not set
