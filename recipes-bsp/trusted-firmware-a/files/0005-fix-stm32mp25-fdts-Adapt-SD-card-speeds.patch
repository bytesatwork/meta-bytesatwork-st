From 0b234404373ab386a465931c93bccd3d700f7efa Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Fri, 27 Mar 2026 11:02:26 +0100
Subject: [PATCH] fix(stm32mp25-fdts): Adapt SD card speeds

Reduce max frequency for SD card interface and disable high speed to
prevent boot failures caused by "slow" SD cards.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 fdts/stm32mp257f-bytedevkit.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/fdts/stm32mp257f-bytedevkit.dts b/fdts/stm32mp257f-bytedevkit.dts
index 672847f80..4c5325672 100644
--- a/fdts/stm32mp257f-bytedevkit.dts
+++ b/fdts/stm32mp257f-bytedevkit.dts
@@ -48,6 +48,9 @@
 	vmmc-supply = <&vdd_sdcard>;
 	vqmmc-supply = <&vddio1>;
 	status = "okay";
+	/delete-property/cap-sd-highspeed;
+	/delete-property/cap-mmc-highspeed;
+	max-frequency = <25000000>;
 };
 
 &usart1 {
