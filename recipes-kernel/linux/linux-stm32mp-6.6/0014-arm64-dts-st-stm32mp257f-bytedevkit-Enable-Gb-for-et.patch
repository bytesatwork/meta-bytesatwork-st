From d2ac78ee91dcfb8d43188b020dbc8f904c158954 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Stephan=20D=C3=BCnner?= <stephan.duenner@bytesatwork.ch>
Date: Thu, 20 Nov 2025 15:30:39 +0100
Subject: [PATCH] arm64: dts: st: stm32mp257f-bytedevkit: Enable Gb for
 eth1/eth2
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enables gigabit connection for eth1 and eth2.

Signed-off-by: Stephan Dünner <stephan.duenner@bytesatwork.ch>
---
 .../boot/dts/st/stm32mp257f-bytedevkit.dts     | 18 ++++++++----------
 1 file changed, 8 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
index 4c3be8099e59..d86d9f238555 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
@@ -219,7 +219,6 @@ &eth1 {
 	pinctrl-1 = <&eth1_rgmii_sleep_pins_b>;
 	pinctrl-names = "default", "sleep";
 	phy-mode = "rgmii-id";
-	max-speed = <100>;
 	phy-handle = <&phy1_eth1>;
 	st,ext-phyclk;
 
@@ -228,16 +227,16 @@ mdio {
 		#size-cells = <0>;
 		compatible = "snps,dwmac-mdio";
 		phy1_eth1: ethernet-phy@0 {
-			compatible = "ethernet-phy-id2000.a231";
+			compatible = "ethernet-phy-ieee802.3-c22";
 			reg = <0>;
 			reset-gpios = <&gpiog 12 GPIO_ACTIVE_LOW>;
 			reset-assert-us = <10000>;
 			reset-deassert-us = <80000>;
+			enet-phy-lane-no-swap;
 			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_25_NS>;
 			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_25_NS>;
-			realtek,eee-disable;
-			interrupt-parent = <&gpioh>;
-			interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
+			ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
+			ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
 		};
 	};
 };
@@ -248,7 +247,6 @@ &eth2 {
 	pinctrl-1 = <&eth2_rgmii_sleep_pins_a>;
 	pinctrl-names = "default", "sleep";
 	phy-mode = "rgmii-id";
-	max-speed = <100>;
 	phy-handle = <&phy1_eth2>;
 	st,ext-phyclk;
 
@@ -257,16 +255,16 @@ mdio {
 		#size-cells = <0>;
 		compatible = "snps,dwmac-mdio";
 		phy1_eth2: ethernet-phy@0 {
-			compatible = "ethernet-phy-id2000.a231";
+			compatible = "ethernet-phy-ieee802.3-c22";
 			reg = <0>;
 			reset-gpios = <&gpioh 6 GPIO_ACTIVE_LOW>;
 			reset-assert-us = <10000>;
 			reset-deassert-us = <80000>;
+			enet-phy-lane-no-swap;
 			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_25_NS>;
 			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_25_NS>;
-			realtek,eee-disable;
-			interrupt-parent = <&gpioh>;
-			interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
+			ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
+			ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
 		};
 	};
 };
