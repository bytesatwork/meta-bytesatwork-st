From 75561dd9d00b4a26cc02fa54f4019442070c2653 Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Tue, 11 Aug 2026 17:33:47 +0200
Subject: [PATCH] ARM: configs: Add display fragment

Add required kernel configs for STM32MP1 display support.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 arch/arm/configs/fragment-901-bytedevkit.config | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm/configs/fragment-901-bytedevkit.config b/arch/arm/configs/fragment-901-bytedevkit.config
index 132056c199b5..fad672f7b9ed 100644
--- a/arch/arm/configs/fragment-901-bytedevkit.config
+++ b/arch/arm/configs/fragment-901-bytedevkit.config
@@ -98,3 +98,15 @@ CONFIG_BPF_LSM=y
 CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
 CONFIG_PSI=y
 # CONFIG_AUDIT is not set
+
+# Display + psplash
+CONFIG_TOUCHSCREEN_GOODIX=y
+CONFIG_TOUCHSCREEN_EDT_FT5X06=y
+CONFIG_DRM_STM=y
+CONFIG_DRM_STM_DSI=y
+CONFIG_DRM_PANEL_SIMPLE=y
+CONFIG_DRM_PANEL_HIMAX_HX8394=y
+CONFIG_DRM_DISPLAY_CONNECTOR=y
+CONFIG_DRM_DW_MIPI_DSI=y
+CONFIG_BACKLIGHT_PWM=y
+CONFIG_BACKLIGHT_GPIO=y
