From adf789fd57ed9788d21ecc10b929191a78fca418 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Wed, 25 Mar 2026 10:31:23 +0100
Subject: [PATCH] arm64: dts: st: stm32mp257f-bytedevkit: Disable MIPI touch

To keep a clean boot output, remove MIPI touchscreen for LVDS setup.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
index 677319e2eb..a63b625580 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
@@ -334,7 +334,7 @@ gt911@5d {
 		reg = <0x5d>;
 		interrupt-parent = <&gpioi>;
 		interrupts = <8 0>;
-		status = "okay";
+		status = "disabled";
 
 		irq-gpios = <&gpioi 8 0>;
 		reset-gpios = <&gpioz 0 0>;
