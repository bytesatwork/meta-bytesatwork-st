Subject: [PATCH] dt-bindings: arm: bytesatwork: Add module and board

Add document the bytes at work AG vendor prefix.
Add byteENGINE and byteDEVKIT.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Signed-off-by: Daniel Ammann <daniel.ammann@bytesatwork.ch>
---
 .../bindings/arm/bytesatwork/bytesatwork.yaml | 30 +++++++
 .../display/panel/youritech,ili9806e.yaml     | 84 +++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |  4 +
 MAINTAINERS                                   |  2 +
 4 files changed, 120 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
 create mode 100644 Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml

diff --git a/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
new file mode 100644
index 000000000000..567086eb9248
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/bytesatwork/bytesatwork.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: bytes at work Platforms Device Tree Bindings
+
+maintainers:
+  - Daniel Ammann <daniel.ammann@bytesatwork.ch>
+
+properties:
+  $nodename:
+    const: "/"
+  compatible:
+    oneOf:
+      - description: bytes at work byteENGINE
+        items:
+          - enum:
+              - batw,m5
+          - const: batw,m5
+      - description: bytes at work byteDEVKIT
+        items:
+          - enum:
+              - batw,bytedevkit
+          - const: batw,bytedevkit
+
+additionalProperties: true
+
+...
diff --git a/Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml b/Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml
new file mode 100644
index 000000000000..9c5eb2bf2e1f
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/youritech,ili9806e.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MIPI-DSI panel with Youritech ILI9806E Controller
+
+maintainers:
+  - Daniel Ammann <daniel.ammann@bytesatwork.ch>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: youritech,ili9806e
+
+  reg: true
+  port: true
+  reset-gpios: true
+  width-mm: true
+  height-mm: true
+
+  dsi-lanes:
+    description: Number of DSI lanes to be used must be <1> or <2> or <3> or <4>
+    enum: [1, 2, 3, 4]
+
+  video-mode:
+    description: |
+      0 - burst-mode
+      1 - non-burst with sync event
+      2 - non-burst with sync pulse
+      3 - command mode
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1, 2, 3]
+
+required:
+  - compatible
+  - reg
+  - dsi-lanes
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    &dsi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+      status = "okay";
+
+      panel@0 {
+        compatible = "youritech,ili9806e";
+        reg = <0>;
+        backlight = <&mipi_bl>;
+        reset-gpios = <&gpio2 22 GPIO_ACTIVE_HIGH>;
+        dsi-lanes = <2>;
+        video-mode = <2>;	/* 0: burst mode
+              * 1: non-burst mode with sync event
+              * 2: non-burst mode with sync pulse
+              */
+        width-mm = <68>;
+        height-mm = <121>;
+        status = "okay";
+
+        port {
+          panel_mipi_in: endpoint {
+            remote-endpoint = <&dsi_out>;
+          };
+        };
+      };
+
+      ports {
+        port@1 {
+          reg = <1>;
+
+          dsi_out: endpoint {
+            remote-endpoint = <&panel_mipi_in>;
+          };
+        };
+      };
+    };
+...
