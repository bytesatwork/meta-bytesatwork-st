From 0a8e115898034e2cce92090ba2d6c054e07e280a Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Wed, 9 Sep 2026 12:05:03 +0200
Subject: [PATCH] arm64: dts: st: stm32mp257f-bytedevkit-v2: dts: Add PCIe
 support

Add PCIe pinctrl states and enable the PCIe root complex on the
STM32MP257F byteDEVKIT.

Configure the PCIe wake GPIO and enable wakeup support.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 .../boot/dts/st/stm32mp257f-bytedevkit-v2.dts | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit-v2.dts b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit-v2.dts
index 17a84e3ddbd8..274437434ecf 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit-v2.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit-v2.dts
@@ -127,6 +127,26 @@ pins {
 			pinmux = <STM32_PINMUX('H', 5, AF12)>;
 		};
 	};
+
+	pcie_pins_a: pcie-0 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, AF4)>;
+			bias-disable;
+		};
+	};
+
+	pcie_init_pins_a: pcie-init-0 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, GPIO)>;
+			output-low;
+		};
+	};
+
+	pcie_sleep_pins_a: pcie-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, ANALOG)>;
+		};
+	};
 };
 
 &a35ss_syscfg {
@@ -594,3 +614,12 @@ lvds_out0: endpoint {
 	};
 };
 
+&pcie_rc {
+	status = "okay";
+	pinctrl-names = "default", "init", "sleep";
+	pinctrl-0 = <&pcie_pins_a>;
+	pinctrl-1 = <&pcie_init_pins_a>;
+	pinctrl-2 = <&pcie_sleep_pins_a>;
+	wake-gpios = <&gpioz 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+	wakeup-source;
+};
