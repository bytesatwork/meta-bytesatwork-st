From bd6d003d5cdbffa81e1a12dbb0ec12735f5e153e Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Tue, 30 Sep 2025 11:56:24 +0200
Subject: [PATCH] ARM: configs: Add nftables fragment

Add necessary configs to use nftables.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 .../configs/fragment-901-bytedevkit.config    | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/arch/arm/configs/fragment-901-bytedevkit.config b/arch/arm/configs/fragment-901-bytedevkit.config
index e8f6aec153..592dcca226 100644
--- a/arch/arm/configs/fragment-901-bytedevkit.config
+++ b/arch/arm/configs/fragment-901-bytedevkit.config
@@ -11,3 +11,41 @@ CONFIG_FRAMEBUFFER_CONSOLE=y
 CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
 # CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is not set
 # CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
+
+# Core Netfilter framework
+CONFIG_NETFILTER=y
+CONFIG_NETFILTER_ADVANCED=y
+
+# nf_tables core
+CONFIG_NF_TABLES=y
+CONFIG_NF_TABLES_INET=y
+CONFIG_NF_TABLES_IPV4=y
+CONFIG_NF_TABLES_IPV6=y
+
+# Connection tracking (required for ct state)
+CONFIG_NF_CONNTRACK=y
+CONFIG_NF_CONNTRACK_MARK=y
+CONFIG_NF_CONNTRACK_EVENTS=y
+
+# nftables expressions used in nftables.conf
+CONFIG_NFT_CT=y
+CONFIG_NFT_COUNTER=y
+CONFIG_NFT_LOG=y
+CONFIG_NFT_LIMIT=y
+CONFIG_NFT_REJECT=y
+CONFIG_NFT_REJECT_INET=y
+
+# For protocol/port matching
+CONFIG_NFT_META=y
+CONFIG_NFT_RT=y
+CONFIG_NFT_EXTHDR=y
+CONFIG_NFT_NUMGEN=y
+CONFIG_NFT_SOCKET=y
+
+# Set/map support (needed for vmap, tcp port sets, etc.)
+CONFIG_NFT_SET_HASH=y
+CONFIG_NFT_SET_RBTREE=y
+
+# Protocol helpers
+CONFIG_IP6_NF_IPTABLES=y
+CONFIG_IP_NF_IPTABLES=y
