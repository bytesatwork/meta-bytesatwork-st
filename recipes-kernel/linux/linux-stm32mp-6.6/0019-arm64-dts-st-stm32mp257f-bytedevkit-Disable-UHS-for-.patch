From 0a1f986e9192a9bba0e94015c4cc91c5168f7a9f Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Fri, 27 Mar 2026 10:03:48 +0100
Subject: [PATCH] arm64: dts: st: stm32mp257f-bytedevkit: Disable UHS for SD
 card

Disables UHS speeds for SD card.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
index a63b625580..7990dd015b 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-bytedevkit.dts
@@ -427,11 +427,6 @@ &sdmmc1 {
 	bus-width = <4>;
 	vmmc-supply = <&scmi_vdd_sdcard>;
 	vqmmc-supply = <&scmi_vddio1>;
-	sd-uhs-sdr12;
-	sd-uhs-sdr25;
-	sd-uhs-sdr50;
-	sd-uhs-ddr50;
-	sd-uhs-sdr104;
 	status = "okay";
 };
 
