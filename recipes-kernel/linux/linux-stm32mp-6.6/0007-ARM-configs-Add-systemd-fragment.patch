From b5e8fdb66e66af03b7358290a5bd37914463e7b7 Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Tue, 30 Sep 2025 16:23:00 +0200
Subject: [PATCH] ARM: configs: Add systemd fragment

Add required configs for systemd.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 .../configs/fragment-901-bytedevkit.config    | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/arch/arm/configs/fragment-901-bytedevkit.config b/arch/arm/configs/fragment-901-bytedevkit.config
index 592dcca226..132056c199 100644
--- a/arch/arm/configs/fragment-901-bytedevkit.config
+++ b/arch/arm/configs/fragment-901-bytedevkit.config
@@ -49,3 +49,52 @@ CONFIG_NFT_SET_RBTREE=y
 # Protocol helpers
 CONFIG_IP6_NF_IPTABLES=y
 CONFIG_IP_NF_IPTABLES=y
+
+# Systemd
+CONFIG_DEVTMPFS=y
+CONFIG_CGROUPS=y
+CONFIG_INOTIFY_USER=y
+CONFIG_SIGNALFD=y
+CONFIG_TIMERFD=y
+CONFIG_EPOLL=y
+CONFIG_UNIX=y
+CONFIG_SYSFS=y
+CONFIG_PROC_FS=y
+CONFIG_FHANDLE=y
+# CONFIG_SYSFS_DEPRECATED is not set
+CONFIG_UEVENT_HELPER_PATH=""
+# CONFIG_FW_LOADER_USER_HELPER is not set
+CONFIG_DMIID=y
+CONFIG_BLK_DEV_BSG=y
+CONFIG_NET_NS=y
+CONFIG_USER_NS=y
+CONFIG_IPV6=y
+CONFIG_AUTOFS_FS=y
+CONFIG_TMPFS_XATTR=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_BTRFS_FS_POSIX_ACL=y
+CONFIG_SECCOMP=y
+CONFIG_SECCOMP_FILTER=y
+CONFIG_KCMP=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_CFS_BANDWIDTH=y
+CONFIG_BPF=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+CONFIG_HAVE_EBPF_JIT=y
+CONFIG_CGROUP_BPF=y
+CONFIG_EFIVAR_FS=y
+CONFIG_EFI_PARTITION=y
+CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
+CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_SECONDARY_KEYRING=y
+CONFIG_IMA_ARCH_POLICY=y
+CONFIG_INTEGRITY_MACHINE_KEYRING=y
+CONFIG_DMI=y
+CONFIG_DMI_SYSFS=y
+CONFIG_BPF_LSM=y
+# CONFIG_RT_GROUP_SCHED is not set
+CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
+CONFIG_PSI=y
+# CONFIG_AUDIT is not set
