From 87922cf7defc967fdb741ab8f8d031c364ac58d3 Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Wed, 9 Sep 2026 12:06:49 +0200
Subject: [PATCH] arm64: bytedevkit_stm32mp2_defconfig: Enable PCIe and Intel
 Wi-Fi

Enable PCIe AER injection support and Intel Wi-Fi drivers for the
STM32MP2 byteDEVKIT.

Enable the Intel IWLWIFI, IWLDVM and IWLMVM drivers required for
Intel Wi-Fi adapters.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 arch/arm64/configs/bytedevkit_stm32mp2_defconfig | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/bytedevkit_stm32mp2_defconfig b/arch/arm64/configs/bytedevkit_stm32mp2_defconfig
index 4621d1e4bc2b..05100feb5aaa 100644
--- a/arch/arm64/configs/bytedevkit_stm32mp2_defconfig
+++ b/arch/arm64/configs/bytedevkit_stm32mp2_defconfig
@@ -76,6 +76,7 @@ CONFIG_MODULE_UNLOAD=y
 # CONFIG_COMPAT_BRK is not set
 CONFIG_MEMORY_HOTPLUG=y
 CONFIG_MEMORY_HOTREMOVE=y
+CONFIG_PAGE_REPORTING=y
 CONFIG_KSM=y
 CONFIG_MEMORY_FAILURE=y
 CONFIG_TRANSPARENT_HUGEPAGE=y
@@ -164,7 +165,6 @@ CONFIG_BT_MRVL_SDIO=m
 CONFIG_BT_NXPUART=m
 CONFIG_CFG80211=m
 CONFIG_MAC80211=m
-CONFIG_MAC80211_LEDS=y
 CONFIG_RFKILL=m
 CONFIG_NET_9P=y
 CONFIG_NET_9P_VIRTIO=y
@@ -174,6 +174,7 @@ CONFIG_NFC_S3FWRN5_I2C=m
 CONFIG_PCI=y
 CONFIG_PCIEPORTBUS=y
 CONFIG_PCIEAER=y
+CONFIG_PCIEAER_INJECT=y
 CONFIG_PCIEASPM_POWERSAVE=y
 CONFIG_PCI_IOV=y
 CONFIG_PCI_PASID=y
@@ -333,6 +334,9 @@ CONFIG_ATH11K=m
 CONFIG_ATH11K_AHB=m
 CONFIG_ATH11K_PCI=m
 CONFIG_BRCMFMAC=m
+CONFIG_IWLWIFI=m
+CONFIG_IWLDVM=m
+CONFIG_IWLMVM=m
 CONFIG_MWIFIEX=m
 CONFIG_MWIFIEX_SDIO=m
 CONFIG_MWIFIEX_PCIE=m
@@ -780,9 +784,7 @@ CONFIG_QCOM_HIDMA=y
 CONFIG_STM32_DMA3=y
 CONFIG_VFIO=y
 CONFIG_VFIO_PCI=y
-CONFIG_VIRTIO_PCI=y
-CONFIG_VIRTIO_BALLOON=y
-CONFIG_VIRTIO_MMIO=y
+# CONFIG_VIRTIO_MENU is not set
 CONFIG_XEN_GNTDEV=y
 CONFIG_XEN_GRANT_DEV_ALLOC=y
 CONFIG_STAGING=y
