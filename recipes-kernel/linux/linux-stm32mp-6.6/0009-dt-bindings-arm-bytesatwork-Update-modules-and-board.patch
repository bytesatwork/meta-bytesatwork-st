From a6d21e33afd2cc25d14dcf22df15e26399aa07ab Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Thu, 30 Oct 2025 16:03:38 +0100
Subject: [PATCH] dt-bindings: arm: bytesatwork: Update modules and boards

Update modules and boards for byteENGINEs and byteDEVKITs.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 .../bindings/arm/bytesatwork/bytesatwork.yaml | 25 +++++++++++++------
 .../devicetree/bindings/vendor-prefixes.yaml  |  2 +-
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
index 567086eb9248..d9a7475ca2b1 100644
--- a/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
+++ b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/arm/bytesatwork/bytesatwork.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: bytes at work Platforms Device Tree Bindings
+title: bytesatwork Platforms Device Tree Bindings
 
 maintainers:
   - Daniel Ammann <daniel.ammann@bytesatwork.ch>
@@ -14,16 +14,27 @@ properties:
     const: "/"
   compatible:
     oneOf:
-      - description: bytes at work byteENGINE
+      - description: bytesatwork byteENGINE
         items:
           - enum:
-              - batw,m5
-          - const: batw,m5
-      - description: bytes at work byteDEVKIT
+              - bytesatwork,byteengine-am62px
+              - bytesatwork,byteengine-am62x
+              - bytesatwork,byteengine-imx8mm
+              - bytesatwork,byteengine-imx8mp
+              - bytesatwork,byteengine-imx93
+              - bytesatwork,byteengine-stm32mp1
+              - bytesatwork,byteengine-stm32mp2
+
+      - description: bytesatwork byteDEVKIT
         items:
           - enum:
-              - batw,bytedevkit
-          - const: batw,bytedevkit
+              - bytesatwork,bytedevkit-am62px
+              - bytesatwork,bytedevkit-am62x
+              - bytesatwork,bytedevkit-imx8mm
+              - bytesatwork,bytedevkit-imx8mp
+              - bytesatwork,bytedevkit-imx93
+              - bytesatwork,bytedevkit-stm32mp1
+              - bytesatwork,bytedevkit-stm32mp2
 
 additionalProperties: true
 
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index ae4a8ce33e4c..04fed343cbd8 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -186,7 +186,7 @@ patternProperties:
     description: BAIKAL ELECTRONICS, JSC
   "^bananapi,.*":
     description: BIPAI KEJI LIMITED
-  "^batw,.*":
+  "^bytesatwork,.*":
     description: bytes at work AG
   "^beacon,.*":
     description: Compass Electronics Group, LLC
